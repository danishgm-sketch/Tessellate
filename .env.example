# Tessellate Environment Variables

# GitHub OAuth (for Better Auth cloud identity)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Better Auth Secret & Base URL
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8787

# Public Origins
PUBLIC_SITE_URL=http://localhost:4321
PUBLIC_PREVIEW_URL=http://localhost:5173
PUBLIC_API_URL=http://localhost:8787

# Optional Cloudflare / Turnstile Keys
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
