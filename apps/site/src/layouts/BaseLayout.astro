---
/**
 * Shared public-shell layout: one place for the stylesheet, metadata, favicon, skip link,
 * header and footer (Phase 33). The public shell is light by design (D-019).
 */
import '../styles/global.css';
import { Header } from '@tessellate/ui';

interface Props {
  title: string;
  description?: string;
  /** Prevent indexing (account, admin and transactional pages). */
  noindex?: boolean;
  /** Width of the main column. */
  width?: 'narrow' | 'default' | 'wide';
}

const { title, description, noindex = false, width = 'default' } = Astro.props;
const fullTitle = title === 'Tessellate' ? title : `${title} — Tessellate`;
const widthClass = width === 'narrow' ? 'max-w-md' : width === 'wide' ? 'max-w-7xl' : 'max-w-4xl';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <slot name="head" />
  </head>
  <body class="min-h-screen flex flex-col bg-[#F4F2ED] text-[#111217] antialiased font-sans">
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-50 focus:rounded-md focus:bg-white focus:px-3 focus:py-2 focus:text-sm focus:shadow"
      >Skip to content</a
    >
    <Header client:load currentPath={Astro.url.pathname} />
    <main id="main" class={`flex-1 w-full ${widthClass} mx-auto px-4 sm:px-6 py-10`}>
      <slot />
    </main>
    <footer class="border-t border-[#D9D6CF] py-6 text-xs text-[#62666F]">
      <nav aria-label="Legal" class="mx-auto flex max-w-7xl flex-wrap gap-x-5 gap-y-2 px-4 sm:px-6">
        <span>© 2026 Tessellate · MIT licensed</span>
        <a href="/terms" class="hover:text-[#111217]">Terms</a>
        <a href="/privacy" class="hover:text-[#111217]">Privacy</a>
        <a href="/license" class="hover:text-[#111217]">Licence</a>
        <a href="/status" class="hover:text-[#111217]">Status</a>
      </nav>
    </footer>
  </body>
</html>
