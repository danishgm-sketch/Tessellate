---
import '../../styles/global.css';
import fs from 'node:fs';
import path from 'node:path';
import { discoverResources, loadJsonManifest } from '@tessellate/catalog';
import { Header } from '@tessellate/ui';
import { ResourcePreviewFrame } from '../../components/ResourcePreviewFrame';
import { ResourceTabs } from '../../components/ResourceTabs';
import { ResourceInspector } from '../../components/ResourceInspector';
import type { ResourceManifest } from '@tessellate/schemas';

export async function getStaticPaths() {
  const candidates = [
    path.resolve(process.cwd(), 'resources'),
    path.resolve(process.cwd(), '../../resources'),
    path.resolve(process.cwd(), '../resources'),
  ];
  const rootResourcesDir = candidates.find((p) => fs.existsSync(p)) ?? candidates[0]!;
  const discovered = discoverResources(rootResourcesDir);

  return discovered.map((item) => {
    const manifest = loadJsonManifest(item.manifestPath);
    return {
      params: { slug: manifest.slug },
      props: { manifest, sourceCode: fs.readFileSync(path.join(path.dirname(item.manifestPath),'index.tsx'),'utf8') },
    };
  });
}

interface Props {
  manifest: ResourceManifest;
  sourceCode: string;
}

const { manifest,sourceCode } = Astro.props;
const componentName=sourceCode.match(/export (?:function|const) ([A-Z][A-Za-z0-9_]*)/)?.[1];
if(!componentName)throw new Error(`No component export in ${manifest.slug}`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{manifest.name} (@tess/{manifest.slug}) — Tessellate Resource</title>
    <meta name="description" content={manifest.description} />
  </head>
  <body class="bg-[var(--tess-canvas,#F4F2ED)] text-[var(--tess-ink,#111217)] antialiased min-h-screen flex flex-col font-sans">
    <Header client:load />

    <main class="flex-1 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
      <!-- Breadcrumbs -->
      <nav class="flex items-center gap-2 text-xs text-[var(--tess-ink-secondary,#62666F)] mb-6">
        <a href="/" class="hover:text-[var(--tess-cobalt,#2547E8)]">Home</a>
        <span>/</span>
        <a href="/explore" class="hover:text-[var(--tess-cobalt,#2547E8)]">Explore</a>
        <span>/</span>
        <span class="capitalize">{manifest.categories[0]}</span>
        <span>/</span>
        <span class="font-medium text-[var(--tess-ink,#111217)]">{manifest.name}</span>
      </nav>

      <!-- Resource Header Title & Description -->
      <div class="mb-8 flex flex-col md:flex-row md:items-end justify-between gap-4">
        <div class="space-y-2 max-w-3xl">
          <div class="flex flex-wrap items-center gap-2.5">
            <h1 class="text-3xl font-bold tracking-tight text-[var(--tess-ink,#111217)]">
              {manifest.name}
            </h1>
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-[var(--tess-canvas-strong,#ECE9E2)] text-[var(--tess-ink-secondary,#62666F)]">
              @tess/{manifest.slug}
            </span>
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-[var(--tess-canvas-strong,#ECE9E2)] text-[var(--tess-ink-secondary,#62666F)]">
              v{manifest.version}
            </span>
            <span class="px-2 py-0.5 rounded text-xs font-mono font-semibold bg-emerald-50 text-emerald-800 border border-emerald-200">
              {manifest.status}
            </span>
          </div>
          <p class="text-sm md:text-base text-[var(--tess-ink-secondary,#62666F)]">
            {manifest.description}
          </p>
          <div class="pt-2 flex flex-wrap items-center gap-2">
            <span class="text-xs text-[var(--tess-ink-secondary,#62666F)] font-mono">Install:</span>
            <code class="px-2 py-1 rounded text-xs font-mono bg-white border border-[var(--tess-hairline,#D9D6CF)] text-[var(--tess-cobalt,#2547E8)]">
              tess add {manifest.slug}
            </code>
            <code class="px-2 py-1 rounded text-xs font-mono bg-white border border-[var(--tess-hairline,#D9D6CF)] text-[var(--tess-ink-secondary,#62666F)]">
              Registry source: /r/{manifest.slug}.json
            </code>
          </div>
        </div>

        <!-- Tags -->
        <div class="flex flex-wrap gap-1.5 shrink-0">
          {manifest.tags.map((tag) => (
            <span class="px-2 py-0.5 rounded text-xs font-mono bg-white border border-[var(--tess-hairline,#D9D6CF)] text-[var(--tess-ink-secondary,#62666F)]">
              #{tag}
            </span>
          ))}
        </div>
      </div>

      <!-- 72/28 Desktop Layout Split -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-start">
        <div class="lg:col-span-8 xl:col-span-8 flex flex-col gap-8">
          <ResourcePreviewFrame manifest={manifest} client:load />
          <ResourceTabs manifest={manifest} sourceCode={sourceCode} client:load />
        </div>

        <div class="lg:col-span-4 xl:col-span-4">
          <ResourceInspector manifest={manifest} componentName={componentName} client:load />
        </div>
      </div>
    </main>

    <footer class="mt-auto border-t border-[var(--tess-hairline,#D9D6CF)] py-8 px-4 text-center text-xs text-[var(--tess-ink-muted,#62666F)]">
      Tessellate Interface Intelligence Layer — Open resource library under {manifest.license.spdx} License.
    </footer>
  </body>
</html>
