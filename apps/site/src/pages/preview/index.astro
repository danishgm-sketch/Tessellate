---
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tessellate Resource Preview</title>
  </head>
  <body style="margin: 0; min-height: 100vh; background: transparent;">
    <div
      id="preview-navigation-request"
      hidden
      role="status"
      aria-live="polite"
      class="fixed inset-x-4 top-4 z-50 mx-auto flex max-w-3xl flex-wrap items-center justify-between gap-3 rounded-lg border border-neutral-300 bg-white p-4 text-sm text-neutral-800 shadow-lg"
    >
      <p class="m-0">
        This isolated preview requested a link to
        <code id="preview-navigation-label" class="font-mono"></code>.
      </p>
      <span class="flex items-center gap-3">
        <a id="preview-navigation-link" class="font-semibold text-blue-700 underline underline-offset-2">
          Open preview link
        </a>
        <button id="dismiss-preview-navigation" type="button" class="underline underline-offset-2">
          Dismiss
        </button>
      </span>
    </div>
    <iframe
      data-tessellate-preview-frame
      title="Isolated Tessellate resource preview"
      sandbox="allow-scripts"
      referrerpolicy="no-referrer"
      style="display: block; width: 100%; height: 100vh; border: 0; background: transparent;"
    ></iframe>
    <script>
      import '../../scripts/preview-wrapper';
    </script>
  </body>
</html>
