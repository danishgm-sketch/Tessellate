---
import '../styles/global.css';
import { SiteHeader } from '../components/home/SiteHeader';
import { ShowcasesGallery } from '../components/ShowcasesGallery';
import { FinalComposerFooter } from '../components/home/FinalComposerFooter';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Showcases — Tessellate Open Interface Library</title>
    <meta
      name="description"
      content="8 production showcase projects demonstrating distinct Design DNA profiles, navigation models, and verified component compositions."
    />
  </head>
  <body class="min-h-screen bg-[#F4F2ED] text-[#111217] selection:bg-[#2547E8] selection:text-white">
    <SiteHeader client:load />

    <main id="main-content" class="max-w-[1440px] mx-auto px-6 py-12 space-y-8">
      <div class="space-y-2 max-w-2xl">
        <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#62666F]">
          Showcase Projects • Phase 19
        </span>
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-[#111217]">
          Distinct Systems for Real Products
        </h1>
        <p class="text-sm md:text-base text-[#62666F] leading-relaxed">
          Tessellate does not sell a generic purple AI template. Every showcase occupies a unique, mathematically verified Design DNA region with its own navigation model and editorial atmosphere.
        </p>
      </div>

      <ShowcasesGallery client:load />
    </main>

    <FinalComposerFooter client:idle />
  </body>
</html>
