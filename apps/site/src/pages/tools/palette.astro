---
import '../../styles/global.css';
import { SiteHeader } from '../../components/home/SiteHeader';
import CapabilityNotice from '../../components/CapabilityNotice.astro';
import { PaletteStudio } from '../../components/tools/PaletteStudio';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Palette Studio — Tessellate Tools</title>
    <meta
      name="description"
      content="Set semantic colour tokens and inspect calculated contrast for selected colour pairs."
    />
  </head>
  <body class="min-h-screen bg-[#F4F2ED] text-[#111217] selection:bg-[#2547E8] selection:text-white flex flex-col font-sans">
    <SiteHeader client:load />

    <main id="main-content" tabindex="-1" class="flex-1 max-w-[1440px] w-full mx-auto px-6 py-12">
      <CapabilityNotice tier="Beta" note="Client-side exploration only. Individual interactions and output quality are still being validated; this tool does not certify or modify a saved Workbench project." />
      <PaletteStudio client:only="react">
        <section
          slot="fallback"
          aria-busy="true"
          class="min-h-[24rem] space-y-6 border-b border-[#D9D6CF] pb-6"
        >
          <div>
            <span class="font-mono text-xs font-semibold uppercase tracking-wider text-[#62666F]">
              Tool 04 · Chroma Architecture
            </span>
            <h1 class="mt-1 text-3xl font-semibold tracking-tight text-[#111217]">Palette Studio</h1>
            <p class="mt-1 text-sm text-[#62666F]">
              Set semantic colour tokens and inspect calculated contrast for selected colour pairs.
            </p>
          </div>
          <p role="status" aria-live="polite" class="text-sm text-[#62666F]">
            Loading Palette Studio controls…
          </p>
        </section>
      </PaletteStudio>
    </main>

    <footer class="border-t border-[#D9D6CF] py-8 text-center text-xs text-[var(--text-muted)] font-mono">
      Tessellate Interface Suite · Tool 04: Palette Studio
    </footer>
  </body>
</html>
