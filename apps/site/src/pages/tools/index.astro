---
import '../../styles/global.css';
import { SiteHeader } from '../../components/home/SiteHeader';
import { ToolsHub } from '../../components/tools/ToolsHub';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Ten Tools — Tessellate Interface Intelligence</title>
    <meta
      name="description"
      content="Ten client-side interface tools for design engineers and autonomous agents: Design DNA, Backgrounds, Motion, Palette, Typography, Layout, Section Planner, Data Viz, Accessibility, and Icons."
    />
  </head>
  <body class="min-h-screen bg-[#F4F2ED] text-[#111217] selection:bg-[#2547E8] selection:text-white flex flex-col font-sans">
    <SiteHeader client:load />

    <main class="flex-1 max-w-[1440px] w-full mx-auto px-6 py-12">
      <ToolsHub client:load />
    </main>

    <footer class="border-t border-[#D9D6CF] py-8 text-center text-xs text-[#8B8F97] font-mono">
      Tessellate Interface Suite · 10 Client-Side Instruments · Zero Login Required
    </footer>
  </body>
</html>
