---
import '../../styles/global.css';
import { SiteHeader } from '../../components/home/SiteHeader';
import { LayoutComposer } from '../../components/tools/LayoutComposer';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Layout Composer — Tessellate Tools</title>
    <meta
      name="description"
      content="Create and test responsive grid and container wireframe structures across viewports."
    />
  </head>
  <body class="min-h-screen bg-[#F4F2ED] text-[#111217] selection:bg-[#2547E8] selection:text-white flex flex-col font-sans">
    <SiteHeader client:load />

    <main class="flex-1 max-w-[1440px] w-full mx-auto px-6 py-12">
      <LayoutComposer client:load />
    </main>

    <footer class="border-t border-[#D9D6CF] py-8 text-center text-xs text-[#8B8F97] font-mono">
      Tessellate Interface Suite · Tool 06: Layout Composer
    </footer>
  </body>
</html>
