---
import '../../styles/global.css';
import { SiteHeader } from '../../components/home/SiteHeader';
import CapabilityNotice from '../../components/CapabilityNotice.astro';
import { DnaLab } from '../../components/DnaLab';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>Design DNA Lab — Tessellate Tools</title>
    <meta
      name="description"
      content="Explore Design DNA presets, adjust 28 numeric dimensions, mix feel descriptors, and inspect inheritance examples."
    />
  </head>
  <body class="min-h-screen bg-[#F4F2ED] text-[#111217] selection:bg-[#2547E8] selection:text-white flex flex-col font-sans">
    <SiteHeader client:load />

    <main id="main-content" tabindex="-1" class="flex-1 max-w-[1440px] w-full mx-auto px-6 py-12">
      <CapabilityNotice tier="Beta" note="Client-side exploration only. Individual interactions and output quality are still being validated; this tool does not certify or modify a saved Workbench project." />
      <DnaLab client:load />
    </main>

    <footer class="border-t border-[#D9D6CF] py-8 text-center text-xs text-[var(--text-muted)] font-mono">
      Tessellate Interface Suite · Tool 01: Design DNA Lab
    </footer>
  </body>
</html>
