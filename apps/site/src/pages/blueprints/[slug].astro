---
import PublicLayout from '../../layouts/PublicLayout.astro';
import {PRODUCT_BLUEPRINTS} from '@tessellate/composer';
export function getStaticPaths(){return PRODUCT_BLUEPRINTS.map(blueprint=>({params:{slug:blueprint.id},props:{blueprint}}));}
const {blueprint}=Astro.props;
---
<PublicLayout title={blueprint.name} description={blueprint.description} tier="Beta" tierNote="This blueprint is a starting point for local composition. Review the generated screens and resources before saving; it does not certify output quality."><div class="grid lg:grid-cols-[2fr_1fr] gap-8"><section class="space-y-8"><div><h2 class="text-xl font-semibold mb-3">Audience and objective</h2><p>{blueprint.defaultAudience}</p><p class="mt-3">{blueprint.defaultObjective}</p></div><div><h2 class="text-xl font-semibold mb-3">Required page classes</h2><ul class="list-disc ml-5 space-y-2">{blueprint.requiredPageClasses.map(page=><li>{page}</li>)}</ul></div><div><h2 class="text-xl font-semibold mb-3">Anti-patterns</h2><ul class="list-disc ml-5 space-y-2">{blueprint.antiPatterns.map(pattern=><li>{pattern}</li>)}</ul></div><a class="inline-block px-5 py-3 bg-[#2547E8] text-white rounded" href={`/compose?blueprint=${blueprint.id}`}>Compose this blueprint</a></section><aside class="border border-[var(--tess-hairline)] p-6 space-y-5"><h2 class="font-semibold">Architecture priors</h2><dl class="space-y-3">{Object.entries(blueprint.priors).map(([key,value])=><div class="flex justify-between gap-4"><dt>{key.replace(/([A-Z])/g,' $1')}</dt><dd class="font-mono">{value}/100</dd></div>)}</dl><h3 class="font-semibold">Responsive strategy</h3><p class="text-sm">{blueprint.responsivePriorities.desktopStrategy}</p><p class="text-sm">{blueprint.responsivePriorities.mobilePhilosophy}</p><h3 class="font-semibold">DNA presets</h3><ul class="text-sm space-y-2">{blueprint.applicableDnaPresets.map(preset=><li>{preset}</li>)}</ul></aside></div></PublicLayout>
