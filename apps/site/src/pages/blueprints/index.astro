---
import PublicLayout from '../../layouts/PublicLayout.astro';
import {PRODUCT_BLUEPRINTS} from '@tessellate/composer';
---
<PublicLayout title="Product blueprints" description="Twelve product architecture priors: audiences, screens, navigation, constraints and anti-patterns. Inspect a blueprint and use it as the starting brief for real composition."><div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">{PRODUCT_BLUEPRINTS.map(blueprint=><article class="border border-[var(--tess-hairline)] bg-[var(--tess-surface)] p-6"><p class="text-xs font-mono mb-3">{blueprint.requiredPageClasses.length} required page classes</p><h2 class="text-xl font-semibold mb-3"><a href={`/blueprints/${blueprint.id}/`} class="hover:underline">{blueprint.name}</a></h2><p class="text-sm leading-relaxed mb-4">{blueprint.description}</p><p class="text-xs text-[var(--tess-ink-secondary)]">{blueprint.defaultNavigationFamily}</p></article>)}</div></PublicLayout>
