---
import BaseLayout from '../layouts/BaseLayout.astro';
import { ForgotPasswordForm } from '../components/auth/AuthForms';
---

<BaseLayout title="Reset your password" width="narrow" noindex>
  <h1 class="text-2xl font-bold tracking-tight">Reset your password</h1>
  <p class="mt-2 mb-6 text-sm text-[#62666F]">Enter your account email and we will send you a link to choose a new password.</p>
  <ForgotPasswordForm client:only="react" />
  <p class="mt-6 text-sm"><a href="/sign-in" class="font-medium text-[#2547E8] hover:underline">Back to sign in</a></p>
</BaseLayout>
