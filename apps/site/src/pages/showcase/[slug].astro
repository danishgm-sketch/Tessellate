---
import PublicLayout from '../../layouts/PublicLayout.astro';
import {SHOWCASE_PROJECTS} from '@tessellate/composer';
import {composeShowcase} from '@tessellate/compatibility';
import {readCatalogue} from '../../lib/catalogue';
import {ShowcasePreview} from '../../components/ShowcasePreview';
export function getStaticPaths(){const catalogue=readCatalogue();return SHOWCASE_PROJECTS.map(showcase=>({params:{slug:showcase.id},props:{manifest:composeShowcase(showcase.id,catalogue)}}));}
const {manifest}=Astro.props;
---
<PublicLayout title={manifest.name} description={manifest.description}><p class="flex flex-wrap gap-6 mb-8"><a class="underline font-semibold" href={`/workbench?showcase=${manifest.id}`}>Edit a local copy in Workbench</a><a class="underline" href={`/data/showcases/${manifest.id}.json`} download={`${manifest.id}.tess.json`}>Download exact example manifest</a></p><ShowcasePreview manifest={manifest} client:load/></PublicLayout>
