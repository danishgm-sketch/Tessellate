---
import PublicLayout from '../../layouts/PublicLayout.astro';
import {documentation} from '../../lib/documentation';
export function getStaticPaths(){return documentation.map(document=>({params:{slug:document.slug},props:document}));}
const {title,Content}=Astro.props;
---
<PublicLayout title={title} description="Canonical repository documentation for this version."><article class="documentation max-w-4xl"><Content/></article><p class="mt-10"><a class="underline" href="/docs">All documentation</a></p></PublicLayout>
<style>.documentation :global(h1),.documentation :global(h2),.documentation :global(h3){font-weight:650;line-height:1.25;margin:1.5em 0 .75em}.documentation :global(h1){font-size:2rem}.documentation :global(h2){font-size:1.5rem}.documentation :global(h3){font-size:1.25rem}.documentation :global(p),.documentation :global(ul),.documentation :global(ol){margin:1em 0;line-height:1.7}.documentation :global(p),.documentation :global(li){overflow-wrap:anywhere}.documentation :global(ul){list-style:disc;padding-left:1.5em}.documentation :global(ol){list-style:decimal;padding-left:1.5em}.documentation :global(a){text-decoration:underline;color:var(--tess-cobalt)}.documentation :global(p code),.documentation :global(li code),.documentation :global(td code),.documentation :global(th code){overflow-wrap:anywhere}.documentation :global(pre){padding:1rem;background:var(--tess-surface);max-width:100%;overflow:auto}.documentation :global(table){display:block;overflow:auto;max-width:100%}.documentation :global(td),.documentation :global(th){border:1px solid var(--tess-hairline);padding:.5rem}</style>
