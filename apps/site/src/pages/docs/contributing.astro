---
import '../../styles/global.css';
import { SiteHeader } from '../../components/home/SiteHeader';
import { FinalComposerFooter } from '../../components/home/FinalComposerFooter';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Contributing Guidelines — Tessellate Documentation</title>
    <meta name="description" content="Guidelines for authoring and contributing components to Tessellate." />
  </head>
  <body class="min-h-screen bg-[#F4F2ED] text-[#111217] selection:bg-[#2547E8] selection:text-white">
    <SiteHeader client:load />

    <main id="main-content" class="max-w-[960px] mx-auto px-4 sm:px-6 py-12 space-y-8">
      <div class="space-y-2">
        <a href="/docs" class="text-xs font-mono text-[#2547E8] hover:underline">← Back to Documentation</a>
        <h1 class="text-3xl font-bold tracking-tight text-[#111217]">Authoring & Contributing Resources</h1>
        <p class="text-sm text-[#62666F]">
          Every resource contributed to Tessellate must be free, un-gated, and adhere to strict accessibility and performance standards.
        </p>
      </div>

      <div class="space-y-6 text-sm leading-relaxed text-[#31353E]">
        <section class="space-y-3 p-6 rounded-2xl bg-white border border-[#D9D6CF]">
          <h2 class="text-base font-bold text-[#111217]">Resource Structure</h2>
          <p class="text-xs text-[#62666F]">
            Every resource in <code>resources/[category]/[slug]/</code> contains three mandatory files:
          </p>
          <pre class="p-3.5 rounded-lg bg-neutral-900 text-neutral-100 font-mono text-xs overflow-x-auto"><code>resources/primitives/button/
├── manifest.json   # Validated ResourceManifest (intent, slots, variants, a11y)
├── index.tsx       # Standalone React component using CSS variables
└── preview.tsx     # Isolated interactive preview component</code></pre>
        </section>

        <section class="space-y-3 p-6 rounded-2xl bg-white border border-[#D9D6CF]">
          <h2 class="text-base font-bold text-[#111217]">Non-Negotiable Quality Gates</h2>
          <ul class="list-disc list-inside text-xs space-y-1.5 text-[#4B505A]">
            <li><strong>WCAG 2.2 AA Compliance:</strong> Minimum 4.5:1 text contrast ratio and keyboard navigable focus states.</li>
            <li><strong>Reduced Motion:</strong> All CSS transitions and animations must respect `prefers-reduced-motion`.</li>
            <li><strong>Zero SaaS Dependencies:</strong> Components cannot require paid hosted APIs or proprietary runtimes.</li>
            <li><strong>Deterministic Verification:</strong> Must validate against `pnpm audit:release-gate`.</li>
          </ul>
        </section>
      </div>
    </main>

    <FinalComposerFooter client:idle />
  </body>
</html>
