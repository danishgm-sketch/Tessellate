/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Content-Security-Policy: default-src 'self' 'unsafe-inline' data:; form-action 'none'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; frame-ancestors 'self' https://tessellate.design https://www.tessellate.design http://localhost:4321 http://localhost:5173; object-src 'none';

/assets/*
  Cache-Control: public, max-age=31536000, immutable
