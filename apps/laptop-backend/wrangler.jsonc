{
  "name": "tessellate-laptop-backend",
  "main": "../api/src/index.ts",
  "compatibility_date": "2026-05-22",
  "compatibility_flags": ["nodejs_compat"],
  "vars": { "RUNTIME_ENVIRONMENT": "development" },
  "ratelimits": [
    { "name": "API_PUBLIC_WRITE_LIMITER", "namespace_id": "858055960608", "simple": { "limit": 20, "period": 60 } },
    { "name": "API_USER_WRITE_LIMITER", "namespace_id": "196024270306", "simple": { "limit": 120, "period": 60 } },
    { "name": "API_AI_LIMITER", "namespace_id": "932497039714", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_AUTH_LIMITER", "namespace_id": "743911765120", "simple": { "limit": 30, "period": 60 } },
    { "name": "API_CLIENT_LIMITER", "namespace_id": "100393578641", "simple": { "limit": 120, "period": 60 } }
  ],
  "d1_databases": [{
    "binding": "DB",
    "database_name": "tessellate-laptop-db",
    "database_id": "00000000-0000-0000-0000-000000000001",
    "migrations_dir": "../api/migrations"
  }]
}
