{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tessellate-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tessellate-db",
      "database_id": "tessellate-db-local",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  }
}
