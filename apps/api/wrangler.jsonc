{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tessellate-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  // Fail-closed default. Local development overrides this via .dev.vars (see .dev.vars.example).
  "vars": {
    "ENVIRONMENT": "production"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tessellate-db",
      // Replaced with the real D1 database id during Phase 34 deployment (owner action).
      "database_id": "tessellate-db-local",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    { "name": "RATE_LIMIT_ENQUEUE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],
  "observability": {
    "enabled": true
  }
}
