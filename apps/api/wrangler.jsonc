{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tessellate-api",
  "main": "src/index.ts",
  "compatibility_date": "2025-02-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // ---- Local development (`wrangler dev`) -------------------------------------------------------
  // Fail-closed default; local development overrides ENVIRONMENT via .dev.vars (see .dev.vars.example).
  // No send_email binding locally: account email is captured in the dev outbox (GET /api/dev/outbox).
  "vars": { "ENVIRONMENT": "production" },
  "d1_databases": [
    { "binding": "DB", "database_name": "tessellate-db", "database_id": "tessellate-db-local", "migrations_dir": "migrations" }
  ],
  "ratelimits": [
    { "name": "RATE_LIMIT_ENQUEUE", "namespace_id": "1001", "simple": { "limit": 10, "period": 60 } },
    { "name": "RATE_LIMIT_AUTH", "namespace_id": "1002", "simple": { "limit": 20, "period": 60 } }
  ],

  "env": {
    // ---- Staging (`wrangler deploy --env staging`) ----------------------------------------------
    "staging": {
      "name": "tessellate-api-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "BETTER_AUTH_URL": "https://staging.tessellate.design",
        "PUBLIC_SITE_URL": "https://staging.tessellate.design",
        "EMAIL_FROM": "no-reply@tessellate.design",
        "EXTRA_ALLOWED_ORIGINS": "https://staging.tessellate.design,https://staging-preview.tessellate.design"
      },
      "d1_databases": [
        // OWNER: replace with the id printed by `wrangler d1 create tessellate-db-staging`.
        { "binding": "DB", "database_name": "tessellate-db-staging", "database_id": "REPLACE_WITH_STAGING_D1_ID", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT_ENQUEUE", "namespace_id": "2001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMIT_AUTH", "namespace_id": "2002", "simple": { "limit": 20, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    },

    // ---- Production (`wrangler deploy --env production`) ----------------------------------------
    "production": {
      "name": "tessellate-api",
      // The API is served same-origin under the site so session cookies are first-party.
      "routes": [{ "pattern": "tessellate.design/api/*", "zone_name": "tessellate.design" }],
      "vars": {
        "ENVIRONMENT": "production",
        "BETTER_AUTH_URL": "https://tessellate.design",
        "PUBLIC_SITE_URL": "https://tessellate.design",
        "EMAIL_FROM": "no-reply@tessellate.design"
      },
      "d1_databases": [
        // OWNER: replace with the id printed by `wrangler d1 create tessellate-db`.
        { "binding": "DB", "database_name": "tessellate-db", "database_id": "REPLACE_WITH_PRODUCTION_D1_ID", "migrations_dir": "migrations" }
      ],
      "ratelimits": [
        { "name": "RATE_LIMIT_ENQUEUE", "namespace_id": "3001", "simple": { "limit": 10, "period": 60 } },
        { "name": "RATE_LIMIT_AUTH", "namespace_id": "3002", "simple": { "limit": 20, "period": 60 } }
      ],
      "send_email": [{ "name": "EMAIL" }]
    }
  }
}
