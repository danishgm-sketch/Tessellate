# Copy to daemon.env (next to daemon.py) and fill in. Never commit daemon.env.
TESSELLATE_API_URL=https://tessellate.design
# Issued from /admin → Daemon devices (shown once) or `pnpm --filter @tessellate/api daemon:token <name> --remote`.
TESSELLATE_DAEMON_TOKEN=
# auto (WebSocket with HTTP fallback) | http
TESSELLATE_TRANSPORT=auto
